{
  "rewrites": [
    {
      "source": "/api/store-order-completed",
      "destination": "/api/store-order-status"
    },
    {
      "source": "/api/store-order-status-check",
      "destination": "/api/store-order-status"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https: data: blob:; media-src 'self' https://sbgdtuqfrnfeggkwqtrw.supabase.co; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://sbgdtuqfrnfeggkwqtrw.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(index.html|privacy.html|account.html|dashboard.html|store-dashboard.html|platform-dashboard.html|customers-dashboard.html|stores-dashboard.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(index.html|privacy.html|account.html|dashboard.html|store-dashboard.html|platform-dashboard.html|customers-dashboard.html|stores-dashboard.html)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https: data: blob:; media-src 'self' https://sbgdtuqfrnfeggkwqtrw.supabase.co; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://sbgdtuqfrnfeggkwqtrw.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(style.css|style-3.css|fonts.css|portal.css|dashboard.css|app.js|hero-video.js|hero-early.js|consent.js|consent.css|privacy.css|app-core.js|guest-identity.js|auth-session.js|texts.js|portal.js|account.js|dashboard.js|store-dashboard.js|platform-dashboard.js|design-schema.js|design-layer.js|edit-boot.js|edit-mode.js|elan-host-bridge.js|editor/edit-model.js|customers-dashboard.js|stores-dashboard.js|footer-9x16.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/hero.mp4",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/hero-poster.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/design/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
