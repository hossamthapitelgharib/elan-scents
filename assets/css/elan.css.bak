/* Élan Scents – Shared Luxury Styles */

:root {
  --elan-gold: #C9A227;
  --elan-gold-light: #E8D5A3;
  --elan-gold-dark: #A68B1F;
  --elan-ivory: #FBF8F3;
  --elan-cream: #F7F1E8;
  --elan-soft: #F0E9DF;
  --elan-charcoal: #2C2A26;
  --elan-muted: #6B6560;
  --elan-softblack: #1A1816;
}

* {
  scroll-behavior: smooth;
}

body {
  background-color: var(--elan-ivory);
  color: var(--elan-charcoal);
  font-family: 'Cairo', 'Inter', sans-serif;
}

.font-display {
  font-family: 'Playfair Display', serif;
}

/* Soft 3D perfume card */
.perfume-card {
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  background: linear-gradient(145deg, #ffffff 0%, #FBF8F3 100%);
  will-change: transform;
}

.perfume-card:hover {
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 24px 48px -12px rgba(44, 42, 38, 0.18);
}

/* Marquee */
.marquee-container {
  overflow: hidden;
  white-space: nowrap;
}

.marquee-content {
  display: inline-block;
  animation: marquee 30s linear infinite;
}

.marquee-content:hover {
  animation-play-state: paused;
}

@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(50%); }
}

/* Carousel */
.carousel-track {
  display: flex;
  gap: 1.25rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding-bottom: 0.5rem;
}

.carousel-track::-webkit-scrollbar {
  display: none;
}

.carousel-track > * {
  scroll-snap-align: start;
  flex-shrink: 0;
}

/* Brand card */
.brand-card {
  transition: all 0.35s ease;
  background: linear-gradient(160deg, #ffffff 0%, #F7F1E8 100%);
}

.brand-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 40px -10px rgba(201, 162, 39, 0.2);
}

/* Language toggle */
.lang-btn.active {
  background: var(--elan-gold);
  color: white;
}

/* Mobile menu rules are defined in index.html for RTL correctness */

/* Section titles */
.section-title {
  position: relative;
  display: inline-block;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -6px;
  right: 0;
  width: 40%;
  height: 2px;
  background: linear-gradient(90deg, var(--elan-gold), transparent);
}

[dir="ltr"] .section-title::after {
  right: auto;
  left: 0;
  background: linear-gradient(90deg, transparent, var(--elan-gold));
}

/* Announcement bar */
.announce-bar {
  background: linear-gradient(90deg, #1A1816 0%, #2C2A26 50%, #1A1816 100%);
}

/* Cart Drawer */


/* Soft glass effect */
.glass {
  background: rgba(251, 248, 243, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

/* Product image soft zoom */
.product-image-wrap {
  overflow: hidden;
  border-radius: 1rem;
}

.product-image-wrap img {
  transition: transform 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.product-image-wrap:hover img {
  transform: scale(1.05);
}

/* Breadcrumb */
.breadcrumb a:hover {
  color: var(--elan-gold);
}

/* Toast animation */
.elan-toast {
  animation: toastIn 0.3s ease;
}

@keyframes toastIn {
  from {
    opacity: 0;
    transform: translate(-50%, 20px);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

/* Auth modal */
.auth-modal-enter {
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* Line clamp */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Focus states */
button:focus-visible,
a:focus-visible {
  outline: 2px solid var(--elan-gold);
  outline-offset: 2px;
}

/* Responsive adjustments */
@media (max-width: 640px) {
  .perfume-card {
    width: 11rem;
  }
}


/* ===== Cart Drawer UX ===== */
.cart-drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  width: 100%;
  max-width: 26rem;
  z-index: 60;
  display: flex;
  flex-direction: column;
  background: var(--elan-ivory);
  box-shadow: -12px 0 40px rgba(26, 24, 22, 0.18);
  transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform;
  right: 0;
  left: auto;
  transform: translateX(105%);
}
[dir="rtl"] .cart-drawer,
html[dir="rtl"] .cart-drawer {
  right: 0;
  left: auto;
  transform: translateX(105%);
  box-shadow: -12px 0 40px rgba(26, 24, 22, 0.18);
}
[dir="rtl"] .cart-drawer.open,
html[dir="rtl"] .cart-drawer.open {
  transform: translateX(0);
}
[dir="ltr"] .cart-drawer {
  left: 0;
  right: auto;
  transform: translateX(-105%);
  box-shadow: 12px 0 40px rgba(26, 24, 22, 0.18);
}
[dir="ltr"] .cart-drawer.open {
  transform: translateX(0);
}

#cartOverlay {
  transition: opacity 0.3s ease;
  opacity: 0;
  pointer-events: none;
}
#cartOverlay.is-visible {
  opacity: 1;
  pointer-events: auto;
}

.cart-item-row {
  animation: cartItemIn 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.cart-item-row.is-new {
  background: linear-gradient(90deg, rgba(201, 162, 39, 0.12), transparent);
  border-radius: 12px;
}
@keyframes cartItemIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

[data-cart-badge].badge-pulse {
  animation: badgePulse 0.45s ease;
}
@keyframes badgePulse {
  0% { transform: scale(1); }
  40% { transform: scale(1.35); }
  100% { transform: scale(1); }
}

.cart-qty-btn {
  transition: background 0.15s ease, transform 0.15s ease;
  touch-action: manipulation;
}
.cart-qty-btn:active {
  transform: scale(0.92);
  background: var(--elan-soft);
}

#closeCartBtn {
  transition: background 0.2s ease, transform 0.15s ease;
}
#closeCartBtn:hover {
  background: var(--elan-soft);
}
#closeCartBtn:active {
  transform: scale(0.94);
}

.elan-toast {
  animation: toastIn 0.3s ease;
}
@keyframes toastIn {
  from { opacity: 0; transform: translate(-50%, 12px); }
  to { opacity: 1; transform: translate(-50%, 0); }
}
